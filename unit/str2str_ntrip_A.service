[Unit]
Description=RTKBase Ntrip A
#After=network-online.target
#Wants=network-online.target
Requires=str2str_tcp.service
After=str2str_tcp.service

[Service]
Type=simple
SyslogIdentifier=str2str_ntrip_A
LogNamespace=rtkbase_str2str_log
User={user}
ExecStart={script_path}/run_cast.sh in_tcp out_caster_A
ExecStopPost=/usr/bin/python3 {script_path}/tools/stoppost.py %n
Restart=on-failure
RestartSec=30
#Limiting log to 1 msg per minute
#LogRateLimitIntervalSec=1 minute
#LogRateLimitBurst=1
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths={script_path}

[Install]
WantedBy=multi-user.target
